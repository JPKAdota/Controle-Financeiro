# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# backups do banco local (contêm dados financeiros pessoais)
/backups/

# extratos, faturas e exports bancários (dados pessoais — nunca versionar)
*.pdf
*.ofx
*.qfx
*.xls
*.xlsx
/*.csv
*.dump
*.bak
# fixtures sintéticas de teste podem ser liberadas explicitamente:
!api/tests/fixtures/**

# relatórios de teste (podem conter capturas de tela com dados reais)
/playwright-report/
/test-results/
/blob-report/

# python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# worktrees locais do Claude Code
/.claude/worktrees/
